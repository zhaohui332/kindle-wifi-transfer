[app]
title = Kindle\u4f20\u4e66
package.name = kindletransfer
package.domain = org.kindle.transfer
source.dir = .
source.include_exts = py
version = 1.0.0
requirements = python3,kivy
orientation = portrait
fullscreen = 0
android.permissions = INTERNET,ACCESS_WIFI_STATE,ACCESS_NETWORK_STATE
android.api = 33
android.minapi = 21
android.sdk = 33
android.ndk = 25b
android.arch = arm64-v8a
android.enable_androidx = 1
[buildozer]
log_level = 1
